# -- Deployment Environment -
# Which standard the admin console's Config Check (Admin -> Config Check) judges
# this deployment against: development, staging or production. A placeholder
# password is unremarkable in development and a compromise in production, and
# this is how the console tells the two apart.
#
# Purely a reporting setting - nothing behaves differently. Leaving it unset
# infers production unless admin-server was started with --dev, so an existing
# deployment that never sets it is judged strictly rather than reassured.
DEPLOYMENT_ENV=production

# -- Optional Services ------
# Comma-separated compose profiles to switch on.
#   monitoring  - Prometheus + Grafana, a zero-click fleet-health dashboard for
#                 evaluators. See deployment/monitoring/README.md. On by default:
#                 ~235 MiB RAM, <1% CPU on a 20-core host.
COMPOSE_PROFILES=monitoring

# -- Monitoring (Prometheus + Grafana) --
# On by default (COMPOSE_PROFILES=monitoring above). See deployment/monitoring/README.md.
#
# Prometheus itself has no `ports:` entry and is never reachable from the host
# - only Grafana, over the backend network - so it has no port or password to
# set here.
#
# Grafana is proxied through nginx at /grafana/ — open https://<host>/grafana/
# in a browser, or click "Grafana" in the admin console's nav bar. The
# host-port mapping below is the escape hatch for direct access (loopback by
# default; set GRAFANA_BIND=0.0.0.0 for LAN). With subpath mode on,
# http://localhost:3000/ redirects to http://localhost/grafana/ (port dropped),
# so type /grafana/ explicitly when tunneling.
#
# GRAFANA_SERVER_DOMAIN is the external hostname Grafana uses to construct
# correct URLs for itself (copy-link, alert notifications, Grafana Live's
# WebSocket origin check). Set it to the hostname operators and browsers use
# to reach this deployment. Defaults to localhost, which is only correct for a
# loopback deployment — a real deployment MUST set it.
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=CHANGEME
GRAFANA_SERVER_DOMAIN=localhost
# How long Prometheus keeps scraped samples before dropping them. Untested
# against real staging disk sizing - lower it on a small disk.
PROMETHEUS_RETENTION=15d
# admin-server's Config Check (Admin -> Config Check) probes these two
# in-cluster URLs directly to report whether monitoring is actually working -
# Prometheus reachable and scraping, Grafana reachable and its default password
# actually changed. Set to the in-cluster URLs so the check runs whenever the
# monitoring profile is on. Clear both to disable the check (Config Check will
# report monitoring as "not configured").
ADMIN_GRAFANA_BASE_URL=http://grafana:3000
ADMIN_PROMETHEUS_BASE_URL=http://prometheus:9090

# -- Image Registry ---------
# Registry/namespace to pull images from.
# Default (unset) is "ghcr.io/scribear" (GitHub Container Registry), which is
# the only registry CI publishes to. The old Docker Hub "scribear" namespace is
# frozen at the pre-cutover images - pulling from it serves stale code silently.
IMAGE_REGISTRY=ghcr.io/scribear

# -- Image Tags -------------
# Use "latest" for production, "staging" for staging builds, "dev" for local development
IMAGE_TAG=staging

# -- Nginx ------------------
NGINX_PORT=80
NGINX_HTTPS_PORT=443
SSL_CERT_PATH=/etc/ssl/certs/your-cert.cer
SSL_KEY_PATH=/etc/ssl/private/your-key.key

# Onsite-only access gate. Empty/unset uses onsite/allowlist.default.conf and
# onsite/content-default/ - permissive, so a stock deployment is never gated
# by accident. To actually restrict access (every API 403s, every frontend
# redirects to a landing page, for anyone outside these ranges), copy
# onsite-allowlist.example.conf, edit it for your own network, and point
# ONSITE_ALLOWLIST_PATH at your copy. ONSITE_CONTENT_PATH is the directory
# serving the landing page itself (and the ungated /extlanding devops preview
# route - see nginx.conf) - point it at your own directory to customize the
# wording/branding.
ONSITE_ALLOWLIST_PATH=
ONSITE_CONTENT_PATH=

# -- Scripts -----------------
ORIGIN=https://localhost:443

# -- Database ---------------
# Host/port default to the bundled scribear-db container. Point them at a
# managed Postgres to run the database outside this stack - that also needs a
# compose.override.yml to drop the bundled service and its depends_on, see
# deployment/UPGRADING.md.
DB_HOST=scribear-db
DB_PORT=5432
DB_NAME=scribear-db
DB_USER=scribear
DB_PASSWORD=CHANGEME

# -- Database Backups -------
# db-backup pg_dumps DB_NAME (plus a small pg_dumpall --globals-only for
# roles) every BACKUP_INTERVAL_SECONDS and keeps BACKUP_RETENTION_DAYS of it
# under BACKUP_OUTPUT_PATH. Runs by default - these three are safe to leave
# as-is. BACKUP_INTERVAL_SECONDS, BACKUP_OFFSITE_METHOD and BACKUP_ENABLED
# below are also read by admin-server, which reports on db-backup's health
# and configuration in Deployment Check.
#
# This is a recovery POINT of up to BACKUP_INTERVAL_SECONDS, not a recovery
# TIME: a failure 3h59m after the last good dump loses everything since, by
# design - pg_dump is a periodic logical backup, not continuous WAL
# archiving. If that RPO is too high for your data, look at a PITR tool
# (pgBackRest, Barman) instead of shortening this interval indefinitely -
# pg_dump's cost scales with database size, not with how often you run it.
BACKUP_INTERVAL_SECONDS=14400
BACKUP_RETENTION_DAYS=14
BACKUP_OUTPUT_PATH=./db-backups

# Set to false for a deployment on managed Postgres (RDS and similar) that
# already has its own backups. db-backup idles rather than dumping, and
# Deployment Check reports that as a deliberate choice instead of "no backup
# found" forever.
BACKUP_ENABLED=true

# Optional at-rest encryption (GPG AES256, symmetric) for every dump this
# writes or pushes offsite. Empty (the default) leaves dumps exactly as
# pg_dump/pg_dumpall produce them: compressed, NOT encrypted - readable by
# anyone with filesystem access to this host or the offsite one. Set this to
# a high-entropy passphrase to encrypt every dump from then on; db-restore
# needs the SAME value to read one back, and cannot decrypt one written under
# a value that has since changed.
BACKUP_ENCRYPTION_KEY=

# Off-host copy of each dump, over scp or rsync-over-ssh. Local retention
# above shares a disk with the database itself, so it does not survive losing
# this host - set these to also get a copy somewhere else. Leave
# BACKUP_OFFSITE_METHOD=none (the default) to skip this. rsync additionally
# needs the `rsync` binary on the receiving host; scp does not.
BACKUP_OFFSITE_METHOD=none
BACKUP_OFFSITE_HOST=
BACKUP_OFFSITE_PORT=22
BACKUP_OFFSITE_USER=
BACKUP_OFFSITE_PATH=
# Private key for the account above, e.g. `ssh-keygen -t ed25519 -N ""
# -f ./db-backup-ssh-key`, with its public half added to that account's
# authorized_keys. Read whether or not BACKUP_OFFSITE_METHOD is set - unused
# and safe to leave as the placeholder path below otherwise.
#
# The first connection to a new BACKUP_OFFSITE_HOST trusts whatever host key
# it presents (`StrictHostKeyChecking=accept-new`) rather than refusing an
# unknown one - simpler to set up, at the cost of trusting that first
# connection. Pre-populate known_hosts yourself (mount it alongside the key
# above) if that first-contact trust is not acceptable for your threat model.
BACKUP_SSH_KEY_PATH=./db-backup-ssh-key

# -- Telemetry Backplane ----
# Redis, used only by the monitoring/fleet view (B1.7). Nothing in the
# transcription path reads or writes it. Consumers are gated on their own
# REDIS_URL settings, which are unset by default, so this password is used
# solely by the container itself until those are configured.
REDIS_PASSWORD=CHANGEME

# -- Session Manager --------
SESSION_MANAGER_LOG_LEVEL=info
SESSION_MANAGER_API_KEY=CHANGEME
# Per-client-IP rate limits on the two unauthenticated credential-exchange
# routes. The values below ARE the shipped defaults - uncomment only to change
# them. See SessionAuthRateLimitConfig in session-auth.router.ts for how each
# was derived; the short version is that the previous 100/60s fired on a
# 250-seat lecture hall in steady state while doing nothing against guessing.
#
# FAILED_JOIN_CODE is the actual anti-guessing control: it counts only 404s
# (not 410 expiries, which a whole room can produce at once from a stale code
# left on a projector) and is keyed on the client IP, never the join code.
#
# "Per IP" means "per whatever the last hop reported". If you front this stack
# with a load balancer or CDN, enable nginx's set_real_ip_from block too, or
# every request arrives with the proxy's address and these become
# deployment-wide limits.
#SESSION_AUTH_RATE_LIMIT_JOIN_CODE_MAX=600
#SESSION_AUTH_RATE_LIMIT_JOIN_CODE_WINDOW_SEC=60
#SESSION_AUTH_RATE_LIMIT_FAILED_JOIN_CODE_MAX=100
#SESSION_AUTH_RATE_LIMIT_FAILED_JOIN_CODE_WINDOW_SEC=60
#SESSION_AUTH_RATE_LIMIT_REFRESH_MAX=1000
#SESSION_AUTH_RATE_LIMIT_REFRESH_WINDOW_SEC=60

# -- Node Server -----
NODE_SERVER_LOG_LEVEL=info
# Outbound: presented by the Node Server when it calls the Session Manager.
NODE_SERVER_KEY=CHANGEME
# Inbound: required from callers of the Node Server's internal service routes
# (Monitoring Sidecar, later Admin Server). Must be a different secret.
NODE_SERVER_SERVICE_KEY=CHANGEME
JWT_SECRET=CHANGEME-JWT-must-be-at-least-32-characters-long
# Fleet telemetry publishing (B1.7). Unset means this instance does not publish
# and so does not appear in the dashboard's fleet view; nothing else changes.
# Uses REDIS_PASSWORD above:
#   NODE_SERVER_REDIS_URL=redis://:CHANGEME@redis:6379
NODE_SERVER_REDIS_URL=

# -- Demo Caption Room ------
# When enabled, the Node Server auto-emits a never-ending, looping caption
# stream (Alice's Adventures in Wonderland, Chapter V) and the Session Manager
# seeds a matching joinable session, so the client/kiosk/standalone webapps can
# be exercised end-to-end with no microphone, source device, or Python
# transcription service running. See apps/node-server/.env.example and
# apps/session-manager/.env.example for detail.
#
# ON by default in every environment (including production). Uncomment the line
# below to turn it off. The demo session uid uses a built-in default shared by
# both services, so it needs no setting here.
# DEMO_ROOM_ENABLED=false

# -- Admin Website -----
# ADMIN_API_KEY reuses SESSION_MANAGER_API_KEY (see Session Manager section above).
ADMIN_LOG_LEVEL=info
ADMIN_SESSION_SECRET=CHANGEME-admin-session-secret-at-least-32-characters
# "<username> <password>"; empty/unset disables local login.
ADMIN_LOCAL_CREDENTIALS=engrit CHANGEME

# Azure Entra ID SSO. All five must be non-empty for the "Sign in with
# Illinois" button to appear (AzureOidcAuthService.isEnabled() requires
# every one) - leaving any unset keeps SSO off and local login (above) is
# the only way in. See scribear.wiki/Developing Admin.md "Azure Entra ID SSO
# provider" for the one-time Azure app-registration walkthrough and exactly
# where each value below comes from in the Azure portal.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_REDIRECT_URI=
# ADMIN_ALLOWED_GROUP=

# Fleet telemetry read (B1.7). Unset means GET /api/admin/v1/fleet answers 503
# TELEMETRY_UNAVAILABLE; the top-bar /health rollup is unaffected either way.
# Uses REDIS_PASSWORD above:
#   ADMIN_REDIS_URL=redis://:CHANGEME@redis:6379
ADMIN_REDIS_URL=

# -- Transcription Service --
# Selects the transcription-service image: transcription-service-<device>.
#   cpu      - no GPU required
#   cuda     - CUDA 12.2 / cuDNN 8
#   cuda128  - CUDA 12.8 / cuDNN 9; needed for Blackwell (sm_120) and newer GPUs
# The CUDA variants are declared in transcription_service/cuda-variants.json and
# built by CI from one Dockerfile; adding a version there adds a value here.
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_LOG_LEVEL=info
TRANSCRIPTION_API_KEY=CHANGEME
TRANSCRIPTION_WS_INIT_TIMEOUT_SEC=2.5
# Read-only key for transcription-service's /metrics/status, consumed by the
# monitoring sidecar. Distinct from TRANSCRIPTION_API_KEY above, which opens
# transcription sessions: the sidecar polls far more than it needs to act on,
# so one secret for both would make a sidecar compromise enough to open ASR
# sessions. Empty leaves the endpoint unregistered and the sidecar's
# transcription metrics empty.
TRANSCRIPTION_METRICS_KEY=
# Linear-RMS silence floor for the audio meter the transcription service runs on
# every inbound stream. 0.01 is what both that meter and whisper's own
# hallucination threshold already used, so leaving this at the default changes
# nothing; it exists because the number is room-dependent. Raise it for a hall
# whose HVAC never lets the level fall under 0.01, where a dead microphone would
# otherwise never read as silent; lower it for a quiet room with a soft speaker,
# whose real speech would otherwise be reported as silence.
TRANSCRIPTION_AUDIO_SILENCE_THRESHOLD=0.01
# Fleet telemetry publishing (B1.7). Unset means this host does not publish and
# so does not appear in the dashboard's fleet view; provider health is still
# readable over HTTP with the key above. Independent of that key: the endpoint
# and the backplane are switched on separately, since the sidecar polls one and
# admin-server reads the other. Uses REDIS_PASSWORD above:
#   TRANSCRIPTION_REDIS_URL=redis://:CHANGEME@redis:6379
TRANSCRIPTION_REDIS_URL=
# Capacity estimator (admission control §3). transcription-service measures how
# much of a worker one ASR session actually costs and derives a ceiling, N*, on
# how many that worker could carry. That number is published on /metrics/status
# and /providers/health and drawn as "estimated capacity" in the dashboard's
# fleet view. It is OBSERVE-ONLY today: nothing is refused because of it, so
# these three change what is reported, not who gets captions. All three default
# to the shipped values, so leaving this whole block alone changes nothing.
#
# Fraction of a worker the ceiling aims to keep busy. Lower it if you want more
# headroom in the reported number (a worker aiming at 0.85 busy is already close
# to falling behind realtime); raise it towards 1.0 only if you are willing to
# read a ceiling with no slack in it. Dimensionless and the same on every
# device - the hardware-specific half is measured, not configured, so a CPU box
# and a GPU box want the same value here.
TRANSCRIPTION_TARGET_BUSY=0.85
# Floor under the reported ceiling. Exists so one noisy or unlucky measurement
# window can never report a worker's capacity as zero. Raise it only if you know
# a worker genuinely carries more than one session on your hardware.
TRANSCRIPTION_MIN_SESSIONS=1
# Operator hard pin on a worker's session capacity. Empty (the default) leaves
# the estimator auto-tuning. Set it and auto-tuning is off entirely: the
# reported ceiling is exactly this number.
#
# It is the strongest of the three deliberately - it wins over
# TRANSCRIPTION_MIN_SESSIONS above AND over warm-up, so it takes effect from the
# very first request rather than after a measurement it has already overruled.
# That is the point: it is a statement about the deployment, not an estimate,
# and an operator who has measured their own box should not have to wait for the
# service to agree. Use it when you know the answer for this hardware and want
# the dashboard to say so; leave it empty otherwise.
TRANSCRIPTION_MAX_SESSIONS=
PROVIDER_CONFIG_PATH=./provider_config.json
# Provider keys session-manager accepts when a session, schedule or
# auto-session window is created or updated. MUST match the keys under
# "providers" in the provider_config.json above - if you add or remove a
# provider there, mirror it here. An id matching no provider is otherwise
# invisible until stream time, where it closes the transcription socket 1007
# and leaves every viewer of that room on a permanent "reconnecting" banner.
# Empty/unset uses the set shipped in provider_config.template.json.
TRANSCRIPTION_PROVIDER_IDS=debug,whisper,lumen_granite,crisper_whisper
# Host directory bind-mounted at /models inside transcription-service, where
# faster-whisper and silero-vad cache downloaded weights (via HF_HOME). Defaults
# to ./models relative to compose.yml; created automatically on first download.
# A deployment with models already downloaded can point this at that directory
# to avoid a re-download.
MODEL_DOWNLOAD_PATH=./models
# Upstream secret for remote/OpenAI-like transcription providers. Forwarded into
# the transcription-service container; a provider references it by name via the
# "api_key_env" field in provider_config.json. Leave empty unless a configured
# provider forwards audio to an external endpoint.
TRANSCRIPTION_PROVIDER_API_KEY=

# -- Test Audio Devices -----
# Two synthetic source devices an operator drives from the admin console
# (Admin -> Test Audio): `good`, which plays clean speech at an adjustable level
# and noise floor, and `fault`, which reproduces on demand every audio fault the
# stack claims to report. They exist so you can see what an alert looks like
# before it matters.
#
# The generator starts with the rest of the stack, and admin-server is wired to
# it by default. It is nonetheless INERT until you set TEST_AUDIO_DEVICE_SECRET
# below: with no secret both devices report configured:false and refuse to start,
# so the panel is visible but every control is disabled, and the Session Manager
# seeds nothing at all. Setting the secret is the act that arms it - read the
# safety note below before doing that.
#
# THERE IS NO PROVISIONING SCRIPT AND NOTHING TO COPY. Set the two variables
# below and restart; the Session Manager creates the rooms, the devices, their
# credentials and a standing session in each, all at fixed uids, on every boot.
#
# One thing you MUST set for the container to start at all:
# TEST_AUDIO_SERVICE_KEY, below.
#
# ---------------------------------------------------------------------------
# SAFETY - READ BEFORE SETTING THE SECRET.
#
# These devices stream synthetic speech into whatever session is active in their
# room. Each has its own dedicated test room, TEST-AUDIO-GOOD and
# TEST-AUDIO-FAULT.
#
# A device token reaches ONLY ITS OWN DEVICE'S ROOM. Neither device has any way
# to name another, so the device-to-room assignment is the ENTIRE safety
# boundary. Putting one of these devices in a teaching room would inject fixture
# speech into that lecture's live captions, silently, with nothing in the stack
# to notice it.
#
# That assignment is now made IN CODE rather than by hand, which is stronger, not
# weaker: the rooms are seeded under reserved uids no other room can hold, there
# is no argument to point at the wrong one, and room-management REFUSES to move
# either device into another room (409 TEST_AUDIO_DEVICE_NOT_ASSIGNABLE) or to
# hand either test room a different source device.
#
# TWO ROOMS, NOT ONE: a room has exactly one source device, and both devices
# must be able to run at once.
# ---------------------------------------------------------------------------
#
# Shared secret between admin-server and the generator. admin-server injects it
# server-side; the browser never sees it. The generator REFUSES TO START on an
# empty or CHANGEME value - an empty inbound key matches the empty credential an
# unauthenticated caller presents as `Authorization: Bearer `.
#
# REQUIRED. The generator now starts with the rest of the stack, so leaving this
# empty leaves one container exiting on every `up` with a message naming this
# variable. Nothing else in the stack depends on it, so the rest comes up fine.
TEST_AUDIO_SERVICE_KEY=CHANGEME
# Where admin-server finds the generator. Defaulted in compose.yml to the
# in-stack service, so this only needs setting to point somewhere else - or to
# empty, which disables the admin panel and leaves the generator unreachable.
TEST_AUDIO_BASE_URL=http://test-audio-generator:80
# The one credential the two synthetic sources need. Shared by the SESSION
# MANAGER and the generator, and by nothing else - note this is a DIFFERENT
# secret from TEST_AUDIO_SERVICE_KEY above, which is admin-server's inbound key.
#
# The Session Manager seeds both devices with bcrypt(HMAC(secret, deviceUid)) as
# their stored credential; the generator derives the same value and presents
# {deviceUid}:{secret}. No token is ever transmitted between them, so there is
# nothing to copy and nothing to keep in step but this line.
#
# Empty - the default - seeds NOTHING and leaves both devices reporting
# configured:false, which shows as two disabled cards.
#
# To rotate it: change it here and restart the stack. The stored hash is
# re-written from the current value on every Session Manager boot.
# To retire the devices entirely: unset it, restart, then delete the two rooms
# and their devices in the admin console - while a device exists with a hash, its
# derived token remains usable.
TEST_AUDIO_DEVICE_SECRET=
# Hard cap on one run, in seconds. Every run auto-stops at its own requested
# duration with no further instruction; this bounds what may be asked for and is
# what stops a forgotten device streaming into a room overnight.
TEST_AUDIO_MAX_DURATION_SEC=1800
TEST_AUDIO_LOG_LEVEL=info

# -- Monitoring canary -----
# The synthetic canary in the monitoring sidecar: every few minutes it streams a
# known recording into a session as a source device, subscribes to the same
# session as a viewer, and scores the captions that come back. It is what turns
# "the services are up" into "captions actually come out".
#
# THERE IS NOTHING TO PROVISION AND NOTHING TO COPY. Set the one variable below
# and restart; the Session Manager creates the room (MONITORING-CANARY), the
# device, its credential and a standing session, all at fixed uids, on every
# boot, and the sidecar derives the token it presents from the same value.
#
# This replaces MONITORING_CANARY_DEVICE_TOKEN. If your .env still has that key,
# DELETE IT - it is no longer read by anything. See deployment/UPGRADING.md for
# what to do with the device it named.
#
# ---------------------------------------------------------------------------
# SAFETY - READ BEFORE SETTING THE SECRET.
#
# The canary streams fixture speech into whatever session is active in its room,
# UNATTENDED, on a timer, indefinitely. It is the only synthetic source in the
# stack that runs with nobody watching.
#
# A device token reaches ONLY ITS OWN DEVICE'S ROOM. The canary has no way to
# name another, so the device-to-room assignment is the ENTIRE safety boundary.
# Pointing it at a teaching room would inject the fixture recording into that
# lecture's live captions, silently, with nothing in the stack to notice it.
#
# That assignment is now made IN CODE rather than by hand, which is stronger, not
# weaker: the room is seeded under a reserved uid no other room can hold, there
# is no Set-Cookie header to misread and no room to pick wrongly, and
# room-management REFUSES to move the device into another room (409
# CANARY_DEVICE_NOT_ASSIGNABLE) or to hand the canary room a different source
# device (409 CANARY_ROOM_NOT_ASSIGNABLE).
# ---------------------------------------------------------------------------
#
# A DIFFERENT secret from TEST_AUDIO_DEVICE_SECRET above, deliberately. The two
# do the same job for different features, and one variable would tie two
# unrelated decisions together: arming the operator test devices would also start
# the canary, and retiring them would silently stop monitoring.
#
# Empty - the default - seeds NOTHING and leaves the canary switched off, which
# is where a deployment that never provisioned a canary device already was.
#
# To rotate it: change it here and restart the stack. The stored hash is
# re-written from the current value on every Session Manager boot.
# To retire the canary: unset it, restart, then delete the room and its device in
# the admin console - while a device exists with a hash, its derived token
# remains usable.
MONITORING_CANARY_DEVICE_SECRET=
