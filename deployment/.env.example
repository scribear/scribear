# -- Deployment Environment -
# Which standard the admin console's Config Check (Admin -> Config Check) judges
# this deployment against: development, staging or production. A placeholder
# password is unremarkable in development and a compromise in production, and
# this is how the console tells the two apart.
#
# Purely a reporting setting - nothing behaves differently. Leaving it unset
# infers production unless admin-server was started with --dev, so an existing
# deployment that never sets it is judged strictly rather than reassured.
DEPLOYMENT_ENV=production

# -- Optional Services ------
# Comma-separated compose profiles to switch on. Empty runs the core stack only.
#   autoupdate  - watchtower, which polls the registry and recreates any
#                 container whose tag moved. Right for staging, where IMAGE_TAG
#                 tracks a branch. Think before production: recreating a
#                 container ends the WebSockets it was serving, so an update
#                 lands as captions stopping mid-lecture, and with
#                 IMAGE_TAG=latest a merge to main would deploy itself.
COMPOSE_PROFILES=

# Only read when the autoupdate profile is on.
WATCHTOWER_POLL_INTERVAL=1800
# Empty updates every container on the host, ScribeAR or not. To narrow it, set
# a name here and label the containers to include - see deployment/UPGRADING.md.
WATCHTOWER_SCOPE=

# -- Image Registry ---------
# Registry/namespace to pull images from.
# Default (unset) is "ghcr.io/scribear" (GitHub Container Registry).
# Set to "scribear" to pull from Docker Hub instead (deprecated, being retired).
IMAGE_REGISTRY=ghcr.io/scribear

# -- Image Tags -------------
# Use "latest" for production, "staging" for staging builds, "dev" for local development
IMAGE_TAG=staging

# -- Nginx ------------------
NGINX_PORT=80
NGINX_HTTPS_PORT=443
SSL_CERT_PATH=/etc/ssl/certs/your-cert.cer
SSL_KEY_PATH=/etc/ssl/private/your-key.key

# -- Scripts -----------------
ORIGIN=https://localhost:443

# -- Database ---------------
# Host/port default to the bundled scribear-db container. Point them at a
# managed Postgres to run the database outside this stack - that also needs a
# compose.override.yml to drop the bundled service and its depends_on, see
# deployment/UPGRADING.md.
DB_HOST=scribear-db
DB_PORT=5432
DB_NAME=scribear-db
DB_USER=scribear
DB_PASSWORD=CHANGEME

# -- Telemetry Backplane ----
# Redis, used only by the monitoring/fleet view (B1.7). Nothing in the
# transcription path reads or writes it. Consumers are gated on their own
# REDIS_URL settings, which are unset by default, so this password is used
# solely by the container itself until those are configured.
REDIS_PASSWORD=CHANGEME

# -- Session Manager --------
SESSION_MANAGER_LOG_LEVEL=info
SESSION_MANAGER_API_KEY=CHANGEME

# -- Node Server -----
NODE_SERVER_LOG_LEVEL=info
# Outbound: presented by the Node Server when it calls the Session Manager.
NODE_SERVER_KEY=CHANGEME
# Inbound: required from callers of the Node Server's internal service routes
# (Monitoring Sidecar, later Admin Server). Must be a different secret.
NODE_SERVER_SERVICE_KEY=CHANGEME
JWT_SECRET=CHANGEME-JWT-must-be-at-least-32-characters-long
# Fleet telemetry publishing (B1.7). Unset means this instance does not publish
# and so does not appear in the dashboard's fleet view; nothing else changes.
# Uses REDIS_PASSWORD above:
#   NODE_SERVER_REDIS_URL=redis://:CHANGEME@redis:6379
NODE_SERVER_REDIS_URL=

# -- Admin Website -----
# ADMIN_API_KEY reuses SESSION_MANAGER_API_KEY (see Session Manager section above).
ADMIN_LOG_LEVEL=info
ADMIN_SESSION_SECRET=CHANGEME-admin-session-secret-at-least-32-characters
# "<username> <password>"; empty/unset disables local login. Azure SSO (AZURE_*) is future.
ADMIN_LOCAL_CREDENTIALS=engrit CHANGEME
# Fleet telemetry read (B1.7). Unset means GET /api/admin/v1/fleet answers 503
# TELEMETRY_UNAVAILABLE; the top-bar /health rollup is unaffected either way.
# Uses REDIS_PASSWORD above:
#   ADMIN_REDIS_URL=redis://:CHANGEME@redis:6379
ADMIN_REDIS_URL=

# -- Transcription Service --
# Selects the transcription-service image: transcription-service-<device>.
#   cpu      - no GPU required
#   cuda     - CUDA 12.2 / cuDNN 8
#   cuda128  - CUDA 12.8 / cuDNN 9; needed for Blackwell (sm_120) and newer GPUs
# The CUDA variants are declared in transcription_service/cuda-variants.json and
# built by CI from one Dockerfile; adding a version there adds a value here.
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_LOG_LEVEL=info
TRANSCRIPTION_API_KEY=CHANGEME
TRANSCRIPTION_WS_INIT_TIMEOUT_SEC=2.5
# Read-only key for transcription-service's /metrics/status, consumed by the
# monitoring sidecar. Distinct from TRANSCRIPTION_API_KEY above, which opens
# transcription sessions: the sidecar polls far more than it needs to act on,
# so one secret for both would make a sidecar compromise enough to open ASR
# sessions. Empty leaves the endpoint unregistered and the sidecar's
# transcription metrics empty.
TRANSCRIPTION_METRICS_KEY=
# Fleet telemetry publishing (B1.7). Unset means this host does not publish and
# so does not appear in the dashboard's fleet view; provider health is still
# readable over HTTP with the key above. Independent of that key: the endpoint
# and the backplane are switched on separately, since the sidecar polls one and
# admin-server reads the other. Uses REDIS_PASSWORD above:
#   TRANSCRIPTION_REDIS_URL=redis://:CHANGEME@redis:6379
TRANSCRIPTION_REDIS_URL=
PROVIDER_CONFIG_PATH=./provider_config.json
# Upstream secret for remote/OpenAI-like transcription providers. Forwarded into
# the transcription-service container; a provider references it by name via the
# "api_key_env" field in provider_config.json. Leave empty unless a configured
# provider forwards audio to an external endpoint.
TRANSCRIPTION_PROVIDER_API_KEY=
