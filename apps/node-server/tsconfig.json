  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "paths": {
      "#src/*": [
        "./src/*"
      ],
      "#tests/*": [
        "./tests/*"
      ]
    }
