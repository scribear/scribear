# Monitoring sidecar — local development

LOG_LEVEL=info
PORT=8004
HOST=127.0.0.1

# Per-provider job periods: `provider=ms` pairs matching `job_period_ms` for
# each provider in the deployed provider_config.json.
#
# Now only a FALLBACK. transcription-service reports its own periods on
# /metrics/status (`providerJobPeriodMs`), sourced from each provider itself, and
# the sidecar prefers those — check `scribear_asr_job_period_ms{source=...}` to
# see which is in use. This variable only matters for a service too old to send
# them, and can be dropped once no such service is polled.
#
# This is the denominator of
# scribear_asr_period_utilization, and it is per provider because job_period_ms
# is: deployment/provider_config.cuda.template.json ships whisper and
# crisper_whisper at 500 and lumen_granite at 3000 in the same file, so one
# global number is wrong for at least one of them. (The `debug` provider has no
# job_period_ms at all — its period is hardcoded to 1000 in debug_provider.py.)
#
# Leave empty, or omit a provider, and no period-utilization series is published
# for it: a missing series beats one silently scaled by the wrong number. A bare
# integer — what this variable used to take — is rejected with an error naming
# this format. Nothing else depends on it; ALERT_RTF_P95 and ALERT_ASR_DUTY_RATIO
# read true RTF, which transcription-service measures for itself.
#
# The values below match the CUDA template. Check yours before copying them.
TRANSCRIPTION_JOB_PERIOD_MS=whisper=500,crisper_whisper=500,lumen_granite=3000

# --- node-server status polling (B1.1) -------------------------------------
# Must match node-server's NODE_SERVER_SERVICE_API_KEY. Empty disables status
# polling, which leaves the WebSocket-close, upstream-churn, auth and
# latency-quality metrics empty: they have no other source, because the log
# parsers that used to infer them were retired when the endpoint landed.
NODE_SERVER_SERVICE_API_KEY=CHANGEME
# Defaults to the probe interval; the two answer adjacent questions.
NODE_STATUS_INTERVAL_SEC=10

# --- transcription-service metrics polling (B1.2) --------------------------
# Must match transcription-service's METRICS_API_KEY. Empty disables the poll,
# which leaves job timings, true RTF, worker utilization and the buffer-overflow
# counters empty: as with node-server above, the log parsers that used to infer
# them were retired when the endpoint landed.
#
# That service leaves the route unregistered when *its* key is empty, so a key
# set here but not there yields a 404, reported as the `not-found` poll reason
# rather than as an auth failure.
TRANSCRIPTION_SERVICE_METRICS_KEY=CHANGEME
TRANSCRIPTION_METRICS_INTERVAL_SEC=10

# --- Probe polling ---------------------------------------------------------
PROBE_INTERVAL_SEC=10
PROBE_TIMEOUT_SEC=5
NODE_SERVER_BASE_URL=http://127.0.0.1:8002
SESSION_MANAGER_BASE_URL=http://127.0.0.1:8001
ADMIN_SERVER_BASE_URL=http://127.0.0.1:8003
TRANSCRIPTION_SERVICE_BASE_URL=http://127.0.0.1:8000

# --- Alert thresholds ------------------------------------------------------
# Defaults from 2026-07-19-01-PLAN-MONITORING-DASHBOARD.md §4. Every one is
# tunable; the plan is explicit that the right value is deployment-specific.
ALERT_RATE_WINDOW_SEC=120
ALERT_UPSTREAM_CHURN_COUNT=3
ALERT_DECODE_DROP_COUNT=10
ALERT_BUFFER_OVERFLOW_COUNT=5
# LEGACY FALLBACK. p95 real-time factor at or above which the T1 CRITICAL fires
# for a transcription-service too old to count dropped periods. Everywhere else
# that CRITICAL is keyed on ALERT_ASR_DROPPED_PERIOD_CRITICAL_RATIO below.
#
# It was the primary signal, and it has the wrong slope: RTF's denominator is
# the audio a pass ingested, and a dropped period leaves that audio for the next
# pass, so RTF FALLS as the service saturates. Measured at 1/2/3/5/8 concurrent
# sessions: mean RTF 0.277 -> 0.139 while the worker went 26% -> 94.5% busy and
# transcripts per 1000 chunks collapsed 190 -> 48. An alert on it was not merely
# silent at 8 sessions, it was moving further from firing.
#
# 2.0 rather than the 1.0 realtime line, for a related reason: measured healthy
# p95 on a GPU stack was 0.96-1.28 while captioning normally, so 1.0 fired on a
# healthy deployment. Passes exceeding realtime are routine - cost tracks the
# unfinalized buffer, and its tail overruns by design. Empty = the compiled
# default, which is the same 2.0. compose.yml plumbs this through as
# MONITORING_RTF_P95.
ALERT_RTF_P95=
# T1 early warning: *mean* RTF over ALERT_RATE_WINDOW_SEC, i.e. the fraction of
# each job period the provider actually spends transcribing. Set below 1.0 so it
# fires while captions are still on time: a job that overruns its period does not
# error or queue, the worker pool just drops the missed periods, so the effective
# period silently becomes a multiple of job_period_ms. A mean rather than a
# percentile because per-pass cost tracks the unfinalized buffer length and is
# bursty by design. Raise ALERT_ASR_DUTY_RATIO_MIN_JOBS if a lightly-used
# deployment produces alerts off a handful of jobs.
#
# 0.45 comes from a measured baseline, not a guess: on an RTX 5070 Ti (whisper
# turbo, 500ms period) healthy single-session operation measured 0.28-0.33 and the
# worst of 388 rolling 120s windows was 0.355. Re-measure on your own hardware
# before trusting it — `npm run asr:load` plus the provider's own asr_rtf sum/count
# is how these numbers were obtained. Note this rule cannot see the shared worker
# saturating under concurrency **on a GPU**: duty ratio falls there as sessions
# pile up, so a quiet value is not evidence transcription is keeping up. On CPU
# it rises instead (0.479 at one session to 1.53 at three, measured), because
# cost is closer to linear in the audio a pass ingests. Do not carry the GPU
# intuition across devices - and read ALERT_ASR_DROPPED_PERIOD_CRITICAL_RATIO
# below for the signal that behaves the same way on both.
#
# GPU-calibrated. The service reports each provider's inference device, and the
# sidecar selects ALERT_ASR_DUTY_RATIO_CPU (below) for a CPU provider, so a
# stock CPU deployment no longer needs a manual override. Setting this variable
# explicitly still wins over both — the existing flat override escape hatch.
# Dense speech pushes it higher still. See the wiki's "Transcription on
# CPU-Only Hardware".
ALERT_ASR_DUTY_RATIO=0.45
# The CPU duty-ratio threshold, selected automatically for a provider the
# service reports as running on CPU. Measured healthy CPU worst case: 0.745
# (speech-dense `small`/8); the GPU default 0.45 sits on the healthy `small`/4
# value (0.471). 0.7 clears that with margin. Empty means "use the default"
# (0.7). Ignored when ALERT_ASR_DUTY_RATIO is set explicitly above.
ALERT_ASR_DUTY_RATIO_CPU=0.7
# Passes needed in the window before ALERT_ASR_DUTY_RATIO's mean is believed.
# Empty also works and falls back to the compiled default (20); compose.yml
# plumbs this through as MONITORING_ASR_DUTY_RATIO_MIN_JOBS.
ALERT_ASR_DUTY_RATIO_MIN_JOBS=20
# T1 tail: the share of job periods in which no pass ran at all, because the pass
# before them overran. This is the exact count of the thing the two thresholds
# above only imply, reported by transcription-service itself; when the polled
# service is too old to report it (a rolling upgrade), the rule falls back to
# asrRtf p99 >= ALERT_ASR_TAIL_P99_RTF instead — 3.0, not the 1.0 realtime line
# this comment used to name. It covers the band between them — a provider whose
# mean is comfortable but whose big-buffer passes overrun, which is normal shape
# rather than a corner case: per-pass cost tracks the unfinalized buffer length,
# and one measured session spread p50 0.235 / p95 0.653 / max 0.840.
#
# Share of scheduled job periods that ran no pass at all. **Measured**, and much
# higher than it looks like it should be: dropping periods is how the provider
# self-throttles when its buffer grows, not a fault. A healthy single session on
# an RTX 5070 Ti dropped 11.3% while captioning perfectly; 3 sessions 26.4%,
# 6 sessions 66.3%. This shipped at 0.01 on reasoning and fired on a healthy stack.
ALERT_ASR_DROPPED_PERIOD_RATIO=0.25
# The same share, at the bar where the service has stopped working rather than
# started straining: the T1 CRITICAL. 50% sits between the 3-session point
# (26.4%, transcripts down ~19%) and the 6-session one (66.3%, transcripts
# collapsed to 48 per 1000 chunks), and it is 4.4x the measured healthy share.
#
# This is the signal ALERT_RTF_P95 above used to carry. Drops are counted by the
# scheduler rather than inferred from a rate, so unlike RTF they rise
# monotonically as the shared worker saturates. Unmeasured on CPU at concurrency.
ALERT_ASR_DROPPED_PERIOD_CRITICAL_RATIO=0.5
# Scheduled periods (drops + passes) needed in the window before either share
# above is believed.
#
# Deliberately NOT a floor on passes. Dropping a period removes a pass, so a
# pass floor rises out of reach exactly as the fault it guards gets worse — the
# same wrong slope that made RTF unusable, reintroduced in the guard. This rule
# set carried a single 100-pass floor until that was noticed, which made the tail
# alert silently inactive on every CPU template (a 120s window holds ~24 periods
# at 5000ms, measured) and on lumen_granite at 3000ms.
#
# 20, matching ALERT_ASR_DUTY_RATIO_MIN_JOBS: at 20 scheduled periods the 25%
# warning needs 5 drops and the 50% critical needs 10, neither a hair trigger.
ALERT_ASR_SCHEDULED_PERIOD_MIN_COUNT=20
# Passes needed before the p99 RTF FALLBACK is believed — that path only, since
# the floor split above. 100 rather than 20 because a p99 over ~24 samples is
# simply the worst pass. Cost of the floor, now confined to a service too old to
# count drops: a provider whose period is long enough that ALERT_RATE_WINDOW_SEC
# holds fewer passes than this gets no tail alert (at 120s, anything above ~1.2s
# — lumen_granite at 3000ms and every CPU template at 5000ms). Widen the window
# for such a deployment rather than lowering this.
ALERT_ASR_TAIL_MIN_JOBS=100
# Reported p99 RTF bar for the fallback path, used only for a transcription-service
# too old to report dropped periods. NOT the 1.0 realtime line: a healthy single
# session measured p99 2.17, so "the worst 1% of passes exceeded realtime" is
# routine. Thinner evidence than the ratio above - one healthy observation.
# Empty also works and falls back to the compiled default (3.0); compose.yml
# plumbs this through as MONITORING_ASR_TAIL_P99_RTF.
ALERT_ASR_TAIL_P99_RTF=3.0
ALERT_PROBE_FAILURE_THRESHOLD=2
ALERT_AUTH_FAILURE_RATIO=0.5
ALERT_AUTH_FAILURE_MIN_SAMPLES=5
# S5: share of latency samples whose end-to-end time computed negative (source
# clock ahead of node-server's). Captions are unaffected; only the measurement
# breaks, so this warns rather than pages.
ALERT_CLOCK_SKEW_RATIO=0.2
ALERT_CLOCK_SKEW_MIN_SAMPLES=20
# N3: audio frames evicted from latency correlation within the window.
ALERT_PENDING_EVICTION_COUNT=10

# Canary thresholds. Tune these against a baseline measured on a healthy
# deployment — the absolute numbers depend on the model and the fixture.
ALERT_CANARY_FIRST_TRANSCRIPT_MS=15000
ALERT_CANARY_MIN_RECALL=0.5
ALERT_CANARY_MAX_REPETITION_RATIO=0.8

# --- Synthetic canary (A2) -------------------------------------------------
# The canary authenticates as a registered ScribeAR device, joins whatever
# session is active in that device's room, streams a known recording as a
# source, subscribes as a viewer, and scores the captions that come back.
#
# THERE IS NO ONE-TIME SETUP ANY MORE, AND NOTHING TO COPY. Set one secret,
# below, on this service and on the Session Manager. The Session Manager seeds
# the canary room (MONITORING-CANARY), its source device and a standing
# open-ended session, all at reserved uids, on every boot; this service derives
# the device token it presents from the same secret and the same uid. No token
# is ever transmitted between them, and there is no Set-Cookie header to read.
#
# This replaced CANARY_DEVICE_TOKEN, which an operator produced by registering a
# device, activating it, scraping the cookie, then creating a room, attaching the
# device, marking it the source and giving the room a schedule.
#
# SAFETY: the canary streams synthetic speech into a REAL session, and it does so
# UNATTENDED, every CANARY_INTERVAL_SEC. The device can only ever reach its own
# device's room — it has no way to name another — so the device-to-room
# assignment is the ENTIRE safety boundary. If it were pointed at a teaching
# room, the fixture recording would be transcribed into that lecture's live
# captions, silently, with nothing in the stack to notice.
#
# That assignment is now made IN CODE, which is STRONGER than making it by hand,
# not weaker: the room and device are seeded under reserved uids no other room or
# device can hold, there is no prompt to misanswer, a re-run repairs a drifted
# assignment rather than adding a second one, and room-management REFUSES
# afterwards to move the device into another room (409
# CANARY_DEVICE_NOT_ASSIGNABLE) or to hand the canary room a different source
# device (409 CANARY_ROOM_NOT_ASSIGNABLE).
#
# This is a DIFFERENT secret from TEST_AUDIO_DEVICE_SECRET, which does the same
# job for the two operator test-audio devices. They are kept apart on purpose:
# one variable would tie two unrelated on/off decisions together, and would hand
# a third service the root key every synthetic device's credential is derived
# from.
#
# Empty disables the canary, and on the Session Manager side seeds nothing at
# all. This service holds no admin key and no token-signing key, so it cannot
# mint credentials for anything but its own room.
#
# To rotate: change it here and on the Session Manager and restart both; the
# stored hash is re-written from the current value on every Session Manager boot.
# To retire the canary: unset it, restart, THEN delete the room and the device in
# the admin console - unsetting alone stops the seeder rewriting the hash but
# does not erase it.
CANARY_DEVICE_SECRET=

CANARY_INTERVAL_SEC=300
CANARY_RUN_DURATION_SEC=40
CANARY_DRAIN_SEC=10
CANARY_UPSTREAM_WAIT_SEC=20

# Paths as laid down by the Dockerfile. For local dev, point at the repo copy:
#   ../../test_audio_files/speech/harvard_16k_mono.wav
CANARY_AUDIO_PATH=/app/test_audio_files/speech/harvard_16k_mono.wav
CANARY_TRANSCRIPT_PATH=/app/test_audio_files/speech/harvard_16k_mono.txt

# 100 ms matches the kiosk's AUDIO_CHUNK_MS, so the canary frames audio at the
# same rate real source devices do.
CANARY_CHUNK_MS=100

# MUST equal sample_rate / num_channels in the canary session's
# transcriptionStreamConfig. The transcription service raises on a mismatch
# instead of resampling, so a wrong value here means every frame is rejected.
# The seeded session leaves that config empty and the whisper-streaming provider
# is hard-wired to 16 kHz mono, so these defaults already agree with it - there
# is nothing to keep in step unless you change both sides.
CANARY_SAMPLE_RATE=16000
CANARY_CHANNELS=1
