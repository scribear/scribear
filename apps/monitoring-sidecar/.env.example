# Monitoring sidecar — local development

LOG_LEVEL=info
PORT=8004
HOST=127.0.0.1

# --- Log ingest ------------------------------------------------------------
# The sidecar reads other containers' logs through the Docker Engine API. The
# socket is mounted read-only and only GETs are issued, but note that access to
# the Docker socket is root-equivalent on the host.
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Compose project name used to discover containers. Must match the project the
# monitored stack runs under, or no containers will be found and the readiness
# probe will report that nothing has been ingested.
COMPOSE_PROJECT=scribear

# Must match `job_period_ms` in the deployed provider_config.json. This is the
# denominator of scribear_asr_period_utilization; a wrong value silently
# rescales that metric and moves the saturation line.
TRANSCRIPTION_JOB_PERIOD_MS=1000

# --- Probe polling ---------------------------------------------------------
PROBE_INTERVAL_SEC=10
PROBE_TIMEOUT_SEC=5
NODE_SERVER_BASE_URL=http://127.0.0.1:8002
SESSION_MANAGER_BASE_URL=http://127.0.0.1:8001
ADMIN_SERVER_BASE_URL=http://127.0.0.1:8003
TRANSCRIPTION_SERVICE_BASE_URL=http://127.0.0.1:8000

# --- Alert thresholds ------------------------------------------------------
# Defaults from PLAN-MONITORING-DASHBOARD.md §4. Every one is tunable; the plan
# is explicit that the right value is deployment-specific.
ALERT_RATE_WINDOW_SEC=120
ALERT_UPSTREAM_CHURN_COUNT=3
ALERT_CONFIG_POLL_ERROR_COUNT=1
ALERT_DECODE_DROP_COUNT=10
ALERT_BUFFER_OVERFLOW_COUNT=5
ALERT_PERIOD_UTILIZATION_P95=1.0
ALERT_PROBE_FAILURE_THRESHOLD=2
ALERT_AUTH_FAILURE_RATIO=0.5
ALERT_AUTH_FAILURE_MIN_SAMPLES=5

# Canary thresholds. Tune these against a baseline measured on a healthy
# deployment — the absolute numbers depend on the model and the fixture.
ALERT_CANARY_FIRST_TRANSCRIPT_MS=15000
ALERT_CANARY_MIN_RECALL=0.5
ALERT_CANARY_MAX_REPETITION_RATIO=0.8

# --- Synthetic canary (A2) -------------------------------------------------
# The canary authenticates as a registered ScribeAR device, joins whatever
# session is active in that device's room, streams a known recording as a
# source, subscribes as a viewer, and scores the captions that come back.
#
# SAFETY: the canary streams synthetic speech into a REAL session. The device
# must therefore belong to a DEDICATED CANARY ROOM. If you point it at a
# teaching room, fixture audio will be transcribed into that lecture's live
# captions. The canary can only reach its own device's room — it has no way to
# name another — so the room assignment is the entire safety boundary.
#
# One-time setup:
#   1. POST /api/session-manager/v1/device-management/register-device
#      with `Authorization: Bearer $ADMIN_API_KEY` -> {activationCode}
#   2. POST /api/session-manager/v1/device-management/activate-device
#      with {activationCode}; read the DEVICE_TOKEN cookie from Set-Cookie
#   3. Create a canary room, add the device, and mark it the source device
#   4. Give the room a standing schedule so a session is always active
#   5. Put the cookie value below (format: {deviceUid}:{secret})
#
# Empty disables the canary. It holds no admin key and no token-signing key,
# so it cannot mint credentials for anything but its own room.
CANARY_DEVICE_TOKEN=

CANARY_INTERVAL_SEC=300
CANARY_RUN_DURATION_SEC=40
CANARY_DRAIN_SEC=10
CANARY_UPSTREAM_WAIT_SEC=20

# Paths as laid down by the Dockerfile. For local dev, point at the repo copy:
#   ../../test_audio_files/speech/harvard_16k_mono.wav
CANARY_AUDIO_PATH=/app/test_audio_files/speech/harvard_16k_mono.wav
CANARY_TRANSCRIPT_PATH=/app/test_audio_files/speech/harvard_16k_mono.txt

# 100 ms matches the kiosk's AUDIO_CHUNK_MS, so the canary frames audio at the
# same rate real source devices do.
CANARY_CHUNK_MS=100

# MUST equal sample_rate / num_channels in the canary session's
# transcriptionStreamConfig. The transcription service raises on a mismatch
# instead of resampling, so a wrong value here means every frame is rejected.
CANARY_SAMPLE_RATE=16000
CANARY_CHANNELS=1
