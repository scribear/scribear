#### Log level to use
LOG_LEVEL=info

#### Host and port server should listen on
HOST=0.0.0.0
PORT=8001

#### Admin authentication
ADMIN_API_KEY=CHANGEME

#### Service-to-service authentication (e.g. Session Stream Server)
SESSION_MANAGER_SERVICE_API_KEY=CHANGEME

#### HMAC key used to sign short-lived session tokens. Must match the key
#### configured on services that verify session tokens (e.g. Session Stream
#### Server). Use a long, high-entropy random string in production.
SESSION_TOKEN_SIGNING_KEY=CHANGEME

# Device presence (B1.6). Devices are stamped as seen on any authenticated
# request; writes are coalesced to at most one per device per write interval.
# The TTL must comfortably exceed the schedule long-poll cycle plus the write
# interval, or a healthy device flips offline between two writes.
DEVICE_LAST_SEEN_WRITE_INTERVAL_SEC=60
DEVICE_ONLINE_TTL_SEC=180

#### Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scribear-db-dev
DB_USER=scribear
DB_PASSWORD=CHANGEME
