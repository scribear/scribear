#### Log level to use
LOG_LEVEL=info

#### Host and port server should listen on
HOST=0.0.0.0
PORT=8001

#### Admin authentication
ADMIN_API_KEY=CHANGEME

#### Service-to-service authentication (e.g. Session Stream Server)
SESSION_MANAGER_SERVICE_API_KEY=CHANGEME

#### HMAC key used to sign short-lived session tokens. Must match the key
#### configured on services that verify session tokens (e.g. Session Stream
#### Server). Use a long, high-entropy random string in production.
SESSION_TOKEN_SIGNING_KEY=CHANGEME

# Device presence (B1.6). Devices are stamped as seen on any authenticated
# request; writes are coalesced to at most one per device per write interval.
# The TTL must comfortably exceed the schedule long-poll cycle plus the write
# interval, or a healthy device flips offline between two writes.
DEVICE_LAST_SEEN_WRITE_INTERVAL_SEC=60
DEVICE_ONLINE_TTL_SEC=180

#### Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scribear-db-dev
DB_USER=scribear
DB_PASSWORD=CHANGEME

#### Demo caption room. When enabled, the Session Manager seeds a joinable demo
#### session ("Demo - Alice in Wonderland") with a rotating join code, whose uid
#### the Node Server publishes a looping fixture caption stream into (see
#### apps/node-server/.env.example). ON by default; uncomment the line below to
#### turn it off.
# DEMO_ROOM_ENABLED=false

#### Fixed UUID for the seeded demo session. Both services ship the same
#### built-in default, so this normally needs no setting; override it only if
#### you set the identical value on the Node Server too - session tokens are
#### verified against the URL's sessionUid, so the two services must agree.
# DEMO_SESSION_UID=deadbeef-0000-4000-8000-000000000001

#### Operator test-audio rooms. The ONE secret behind the two synthetic audio
#### sources (PLAN-TestAudioDevices). Set it to the same value here and on the
#### test-audio generator; those two services are its only holders.
####
#### Set, this service seeds TEST-AUDIO-GOOD and TEST-AUDIO-FAULT, one source
#### device in each at a reserved uid, and one standing open-ended session per
#### room, idempotently on every boot. Each device's stored credential is
#### bcrypt(HMAC(secret, deviceUid)) - exactly what the generator derives - so
#### no token is ever transmitted or pasted anywhere, and there is no
#### provisioning step at all.
####
#### Empty (the default) seeds nothing and leaves both devices reporting
#### configured:false. Changing it and restarting rotates both credentials.
# TEST_AUDIO_DEVICE_SECRET=
