#### Log level to use
LOG_LEVEL=info

#### Host and port server should listen on
HOST=0.0.0.0
PORT=8003

#### Session Manager admin API key. Held ONLY by this BFF and presented as
#### `Authorization: Bearer <key>` on upstream calls. Never shipped to the browser.
#### In the deployment stack this reuses SESSION_MANAGER_API_KEY.
ADMIN_API_KEY=CHANGEME

#### Base URL of the Session Manager service (no trailing slash).
#### In the compose stack this is http://session-manager:80.
SESSION_MANAGER_BASE_URL=http://localhost:8001

# Which standard the Config Check judges this deployment against: development,
# staging or production. Reporting only — nothing behaves differently. Unset
# infers production unless started with --dev, so a real deployment that never
# sets it is judged strictly rather than reassured.
DEPLOYMENT_ENV=development

# Health rollup (B1.5). The admin console reports on these services by reading
# their unauthenticated readiness probes; no API keys are involved. The timeout
# is per component and the components are checked concurrently, so it is also
# the worst case for the whole rollup - keep it short, an admin is waiting.
NODE_SERVER_BASE_URL=http://localhost:8002
TRANSCRIPTION_SERVICE_BASE_URL=http://localhost:8000
HEALTH_CHECK_TIMEOUT_SEC=3

#### Secret used to sign the admin session cookie. Use a long, high-entropy
#### random string in production. Rotating it invalidates all active sessions.
#### Minimum length is enforced at boot.
ADMIN_SESSION_SECRET=CHANGEME-session-secret-at-least-32-characters-long

#### Local staff account, formatted "<username> <password>" (split on the FIRST
#### space only, so the password may contain spaces). Empty/unset DISABLES local
#### login (the switch used to force SSO-only once Azure lands).
ADMIN_LOCAL_CREDENTIALS=

#### Session lifetimes (minutes). Idle: max gap between requests. Absolute: max
#### total lifetime regardless of activity.
ADMIN_SESSION_IDLE_TIMEOUT_MINUTES=60
ADMIN_SESSION_ABSOLUTE_TIMEOUT_MINUTES=480

#### Rate limiting. Global applies to every /api/admin route; login is stricter
#### because it is the credential-guessing surface.
ADMIN_RATE_LIMIT_GLOBAL_MAX=300
ADMIN_RATE_LIMIT_GLOBAL_WINDOW_SEC=60
ADMIN_RATE_LIMIT_LOGIN_MAX=5
ADMIN_RATE_LIMIT_LOGIN_WINDOW_SEC=60

#### Database configuration (used for the admin audit log).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scribear-db-dev
DB_USER=scribear
DB_PASSWORD=CHANGEME

#### (Future) Azure Entra ID SSO. Presence of these enables the SSO provider;
#### leave unset for now. Documented for forward compatibility only.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_REDIRECT_URI=
# ADMIN_ALLOWED_GROUP=

#### Operator test-audio devices. Empty (the default) means the feature is off:
#### the console shows a disabled panel rather than an error, and every mutation
#### answers 503 TEST_AUDIO_UNAVAILABLE.
####
#### The generator is a separate service that starts with the rest of the stack.
#### In compose the URL is defaulted to http://test-audio-generator:80, so only
#### the key needs setting, and it must match that service's own
#### TEST_AUDIO_SERVICE_KEY.
####
#### SAFETY: those devices stream synthetic audio into whatever session is
#### active in their own device's room, and a device token can reach no other
#### room. That room assignment is the entire safety boundary - provision them
#### into dedicated test rooms, never a teaching room.
TEST_AUDIO_BASE_URL=
TEST_AUDIO_SERVICE_KEY=
