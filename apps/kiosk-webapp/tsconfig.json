{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    // Kept outside outDir on purpose. This project is noEmit, so the build info
    // is tsc's only output; leaving it in ./dist meant the `vite build` that
    // follows `tsc -b` emptied that directory and deleted it, so every build
    // re-typechecked the whole project from scratch.
    "tsBuildInfoFile": "./.tsbuildinfo",
    "rootDir": ".",
    "paths": {
      "#src/*": [
        "./src/*"
      ],
      "#tests/*": [
        "./tests/*"
      ]
    },
    "types": [
      "vite/client"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "tests"
  ],
  "references": [
    {
      "path": "../../libs/audio-frame-protocol"
    },
    {
      "path": "../../libs/clients/transcription-service-client"
    },
    {
      "path": "../../libs/clients/base-api-client"
    },
    {
      "path": "../../libs/clients/base-websocket-client"
    },
    {
      "path": "../../libs/clients/base-long-poll-client"
    },
    {
      "path": "../../libs/schemas/session-manager-schema"
    },
    {
      "path": "../../libs/clients/session-manager-client"
    },
    {
      "path": "../../libs/schemas/node-server-schema"
    },
    {
      "path": "../../libs/clients/node-server-client"
    },
    {
      "path": "../../libs/store/redux-remember-store"
    },
    {
      "path": "../../libs/store/app-layout-store"
    },
    {
      "path": "../../libs/store/theme-customization-store"
    },
    {
      "path": "../../libs/store/transcription-content-store"
    },
    {
      "path": "../../libs/store/transcription-display-store"
    },
    {
      "path": "../../libs/store/microphone-store"
    },
    {
      "path": "../../libs/store/url-config-store"
    },
    {
      "path": "../../libs/store/live-translation-store"
    },
    {
      "path": "../../libs/ui/core-ui"
    },
    {
      "path": "../../libs/ui/live-translation-ui"
    },
    {
      "path": "../../libs/ui/theme-customization-ui"
    },
    {
      "path": "../../libs/ui/transcription-display-ui"
    },
    {
      "path": "../../libs/ui/microphone-ui"
    }
  ]
}
