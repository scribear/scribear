{
  "name": "@scribear/transcript-export-store",
  "version": "0.0.0",
  "description": "",
  "author": "scribear",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "type": "module",
  "imports": {
    "#src/*": {
      "development": "./src/*",
      "default": "./dist/src/*"
    },
    "#tests/*": {
      "development": "./tests/*",
      "default": "./dist/tests/*"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "format": "prettier --check ./src",
    "format:fix": "prettier --write ./src",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.11.2",
    "eventemitter3": "5.0.4"
  }
}
