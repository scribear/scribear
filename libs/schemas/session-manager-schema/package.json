{
  "name": "@scribear/session-manager-schema",
  "version": "0.2.0",
  "description": "",
  "author": "scribear",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./test-audio": {
      "development": "./src/test-audio/index.ts",
      "default": "./dist/src/test-audio/index.js"
    }
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": {
      "development": "./src/*",
      "default": "./dist/src/*"
    },
    "#tests/*": {
      "development": "./tests/*",
      "default": "./dist/tests/*"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "format": "prettier --check ./src",
    "format:fix": "prettier --write ./src",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix"
  },
  "dependencies": {
    "typebox": "1.1.5"
  }
}
