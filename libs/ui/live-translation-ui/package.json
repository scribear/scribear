{
  "name": "@scribear/live-translation-ui",
  "version": "0.3.0",
  "description": "",
  "author": "scribear",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "type": "module",
  "imports": {
    "#src/*": {
      "development": "./src/*",
      "default": "./dist/src/*"
    },
    "#tests/*": {
      "development": "./tests/*",
      "default": "./dist/tests/*"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "format": "prettier --check ./src",
    "format:fix": "prettier --write ./src",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "test:unit": "vitest run --project unit"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "axe-core": "4.10.2",
    "jsdom": "29.1.1"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "@scribear/transcription-display-ui": "0.3.0",
    "react": "19.2.5"
  }
}
