# https://docs.npmjs.com/cli/v9/configuring-npm/npmrc

# Ensure NPM saves the exact package version in package.json when adding dependencies
# This ensures the exact same dependencies are always installed
# A mechanism for automatic dependencies updates should be used (e.g. dependabot)
save-exact=true

# @axe-core/puppeteer pulls in puppeteer (not puppeteer-core) as a non-optional
# peer, and its postinstall downloads a full Chrome for Testing build that this
# repo never uses: the a11y and e2e-audio scripts drive puppeteer-core with an
# explicit executablePath (see each script's CHROME_CANDIDATES, none of which
# point at puppeteer's browser cache) and never touch the auto-downloaded
# browser. Skipping the download is a free win on every platform, and it also
# sidesteps the fact that Chrome for Testing publishes no linux-arm64 build at
# all.
#
# That skip now lives in the "puppeteer" key of the root package.json, NOT here.
# It used to be `puppeteer_skip_download=true` on the next line, which was a
# silent no-op: npm forwards unknown keys like that only as npm_config_* env
# vars, and the puppeteer this repo pins (25.3.0, a transitive peer) reads only
# PUPPETEER_* env vars and lilconfig config files — there is no npm_config_*
# fallback left in it. So Chrome downloaded anyway (~640MB) while npm warned
# "Unknown project config".
#
# package.json is the right home rather than a .puppeteerrc.cjs because it is
# the config location that works everywhere: lilconfig searches it first, and
# it is one of the few files that survives the manifest prune in every
# apps/*/Dockerfile, so the skip reaches image builds too. Note that this file
# survives that prune as well now, but moving the key back here would not work
# — puppeteer never reads .npmrc at all.
