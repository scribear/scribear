#### Log level to use
LOG_LEVEL=info

#### Host and port websocket API should listen on
HOST=0.0.0.0
PORT=8000

#### API key required to establish websocket connection
API_KEY=CHANGEME
WS_INIT_TIMEOUT_SEC=2.5

#### API key required to read GET /metrics/status
# Deliberately NOT the same key as API_KEY: that one opens transcription
# sessions and streams audio, this one only reads counters. Empty (the
# default) disables the endpoint entirely - it is not registered, so it 404s.
# Cluster-internal only; it must never be reachable through the reverse proxy.
METRICS_API_KEY=

#### Filepath of provider configuration .json file
PROVIDER_CONFIG_PATH=./provider_config.json
